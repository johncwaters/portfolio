---
import DefaultPage from "./DefaultPage.astro";
import HedgehogMode from "../components/smallparts/HedgehogMode.astro";
import { formatDate } from "../utils/formatDate";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const formattedDate = formatDate(pubDate);
const hasHedgehogMode = tags.includes("posthog");
---

<DefaultPage title={title} description={description} showHeader>
  <article class="max-w-3xl mx-auto px-4 py-16 w-full">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold mb-2">{title}</h1>
      <p class="opacity-70">{formattedDate}</p>
      <div class="flex flex-wrap gap-2 justify-center mt-3">
        {tags.map((tag: string) => <span class="badge badge-outline">{tag}</span>)}
      </div>
    </header>
    <div class="prose max-w-none mx-auto">
      <slot />
    </div>
  </article>
  <aside class="max-w-3xl mx-auto px-4 pb-20 text-center">
    <div class="divider mb-10"></div>
    <h2 class="text-3xl font-bold mb-3">This was one project. There are more.</h2>
    <p class="opacity-80 max-w-xl mx-auto mb-6">
      Everything on this blog comes from something I shipped: AI agent
      platforms, desktop and mobile apps, and the measurement to prove they
      work. The rest of the portfolio is one click away.
    </p>
    <a href="/#professionalwork" class="btn btn-primary">View my projects</a>
  </aside>
  {hasHedgehogMode && <HedgehogMode />}
</DefaultPage>
