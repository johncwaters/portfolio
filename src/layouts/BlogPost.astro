---
import DefaultPage from "./DefaultPage.astro";
import { formatDate } from "../utils/formatDate";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const formattedDate = formatDate(pubDate);
---

<DefaultPage title={title} description={description} showHeader>
  <article class="max-w-3xl mx-auto px-5 sm:px-6 py-8 sm:py-14 w-full">
    <header class="mb-10 sm:mb-12">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-4">{title}</h1>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-70">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags.map((tag: string) => <span>#{tag}</span>)}
      </p>
    </header>
    <div class="prose max-w-[65ch]">
      <slot />
    </div>
  </article>
  <aside class="max-w-3xl mx-auto px-5 sm:px-6 pb-20 text-center">
    <div class="divider mb-10"></div>
    <h2 class="text-3xl font-bold mb-3">Want to see what I build?</h2>
    <p class="opacity-80 max-w-xl mx-auto mb-6">
      Besides writing, I ship AI agent platforms, desktop and mobile apps, and
      the measurement to prove they work. The portfolio is one click away.
    </p>
    <a href="/#professionalwork" class="btn btn-primary">View my projects</a>
  </aside>
</DefaultPage>
