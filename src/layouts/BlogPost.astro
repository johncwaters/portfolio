---
import DefaultPage from "./DefaultPage.astro";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/formatDate";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  keepReadingPosts: CollectionEntry<"blog">[];
}

const { title, description, pubDate, tags, keepReadingPosts } = Astro.props;
const formattedDate = formatDate(pubDate);
---

<DefaultPage title={title} description={description} showHeader>
  <article class="max-w-3xl mx-auto px-5 sm:px-6 py-8 sm:py-14 w-full">
    <header class="mb-10 sm:mb-12">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-4">{title}</h1>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-70">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags.map((tag: string) => <span>#{tag}</span>)}
      </p>
    </header>
    <div class="prose max-w-[65ch]">
      <slot />
    </div>
    <div data-blog-post-end aria-hidden="true"></div>
  </article>
  <aside class="max-w-3xl mx-auto px-5 sm:px-6 pb-16 sm:pb-20 w-full">
    <div class="max-w-[65ch] border-t border-neutral pt-8">
      {
        keepReadingPosts.length > 0 && (
          <nav aria-labelledby="keep-reading-heading" class="mb-6">
            <h2 id="keep-reading-heading" class="text-xs uppercase tracking-widest opacity-70 mb-1">
              Keep reading
            </h2>
            <ul>
              {keepReadingPosts.map((keepReadingPost) => (
                <li>
                  <a
                    href={`/blog/${keepReadingPost.id}/`}
                    class="group block py-3 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
                    data-attr="blog-post-keep-reading"
                  >
                    <span class="block text-lg font-semibold leading-snug group-hover:text-(--brand-pink-soft) group-focus-visible:text-(--brand-pink-soft)">
                      {keepReadingPost.data.title}
                    </span>
                    <time
                      class="block text-sm opacity-70 mt-1"
                      datetime={keepReadingPost.data.pubDate.toISOString()}
                    >
                      {formatDate(keepReadingPost.data.pubDate)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <p class="text-sm">
        <span class="text-(--brand-pink-soft) mr-2" aria-hidden="true">$</span>
        <a
          href="/#professionalwork"
          class="underline underline-offset-4 hover:text-(--brand-pink-soft) focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
          data-attr="blog-post-cta"
        >
          View my projects
        </a>
      </p>
    </div>
  </aside>
  <script is:inline define:vars={{ title, tags }}>
    const articleEnd = document.querySelector("[data-blog-post-end]");
    let accumulatedVisibleMilliseconds = 0;
    let visibleSinceMilliseconds = document.visibilityState === "visible" ? performance.now() : null;
    document.addEventListener("visibilitychange", () => {
      const nowMilliseconds = performance.now();
      if (document.visibilityState === "visible") {
        visibleSinceMilliseconds ??= nowMilliseconds;
        return;
      }
      if (visibleSinceMilliseconds === null) return;
      accumulatedVisibleMilliseconds += nowMilliseconds - visibleSinceMilliseconds;
      visibleSinceMilliseconds = null;
    });
    const measureVisibleMilliseconds = () =>
      visibleSinceMilliseconds === null
        ? accumulatedVisibleMilliseconds
        : accumulatedVisibleMilliseconds + performance.now() - visibleSinceMilliseconds;
    const readObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      readObserver.disconnect();
      window.posthog?.capture("blog_post_read", {
        post_title: title,
        post_tags: tags,
        visible_seconds_to_reach_end: Math.round(measureVisibleMilliseconds() / 1000),
      });
    });
    const isArticleEndInView = () => articleEnd.getBoundingClientRect().top < window.innerHeight;
    const armReadObserver = () => {
      if (isArticleEndInView()) return;
      readObserver.observe(articleEnd);
    };
    if (!isArticleEndInView()) {
      window.addEventListener("scroll", armReadObserver, { once: true, passive: true });
    }
  </script>
</DefaultPage>
