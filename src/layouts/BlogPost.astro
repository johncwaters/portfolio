---
import DefaultPage from "./DefaultPage.astro";
import { formatDate } from "../utils/formatDate";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  cover?: string;
}

const { title, description, pubDate, tags, cover } = Astro.props;
const formattedDate = formatDate(pubDate);
const ogImage = cover?.replace(/\.svg$/, ".png");
---

<DefaultPage title={title} description={description} showHeader image={ogImage}>
  <article class="max-w-3xl mx-auto px-4 py-16 w-full">
    {cover && (
      <img
        src={cover}
        alt={`Cover graphic for ${title}`}
        loading="eager"
        class="aspect-[2048/894] w-full object-cover rounded-lg border border-[var(--brand-line)] mb-10"
      />
    )}
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold mb-2">{title}</h1>
      <p class="opacity-70">{formattedDate}</p>
      <div class="flex flex-wrap gap-2 justify-center mt-3">
        {tags.map((tag: string) => <span class="badge badge-outline">{tag}</span>)}
      </div>
    </header>
    <div class="prose max-w-none mx-auto">
      <slot />
    </div>
  </article>
</DefaultPage>
