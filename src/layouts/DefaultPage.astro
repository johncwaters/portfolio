---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  publishedAt?: Date;
  tags?: string[];
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  showHeader = false,
  publishedAt,
  tags,
} = Astro.props;
---

<!DOCTYPE html>
<html data-theme="dark" lang="en-us" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} publishedAt={publishedAt} tags={tags} />
  </head>

  <body class="flex flex-col min-h-screen">
    <main class="flex flex-col flex-1">
      {showHeader && <Header />}
      <slot />
    </main>
    <footer>
      <Footer />
    </footer>
  </body>
</html>
