---
export const prerender = true;

import DefaultPage from "../../layouts/DefaultPage.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../utils/formatDate";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<DefaultPage
  title="Blog"
  description="Notes on platform engineering, reliability, and AI tooling."
  showHeader
>
  <div class="max-w-3xl mx-auto px-4 py-16 w-full">
    <h1 class="text-4xl font-bold mb-10 text-center">Blog</h1>
    <ul>
      {
        posts.map((post) => (
          <li class="border-b border-neutral py-6">
            <a href={`/blog/${post.id}/`} class="flex gap-5 items-start group">
              {post.data.cover && (
                <img
                  src={post.data.cover}
                  alt={`Cover graphic for ${post.data.title}`}
                  loading="lazy"
                  class="hidden sm:block w-40 shrink-0 aspect-[2048/894] object-cover rounded-lg border border-[var(--brand-line)]"
                />
              )}
              <div class="min-w-0">
                <span class="text-2xl font-semibold group-hover:text-accent">
                  {post.data.title}
                </span>
                <p class="opacity-70 mt-1">{formatDate(post.data.pubDate)}</p>
                <p class="opacity-70 mt-2">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</DefaultPage>
