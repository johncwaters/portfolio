---
export const prerender = true;

import DefaultPage from "../../layouts/DefaultPage.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../utils/formatDate";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<DefaultPage
  title="Blog"
  description="Notes on platform engineering, reliability, and AI tooling."
  showHeader
>
  <div class="max-w-3xl mx-auto px-5 sm:px-6 py-8 sm:py-14 w-full">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-8 sm:mb-10">Blog</h1>
    <ul>
      {
        posts.map((post) => (
          <li class="border-b border-neutral">
            <a
              href={`/blog/${post.id}/`}
              class="block py-6 group focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4"
            >
              <h2 class="text-2xl font-semibold leading-snug group-hover:text-accent group-focus-visible:text-accent">
                {post.data.title}
              </h2>
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-70 mt-2">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                {post.data.tags.map((tag: string) => <span>#{tag}</span>)}
              </p>
              <p class="opacity-70 mt-2">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</DefaultPage>
