---
import { Image } from "astro:assets";

export interface Props {
  image: ImageMetadata;
  title: string;
  message: string;
  hrefUrl: string;
  altText: string;
}

const { image, title, message, hrefUrl, altText } = Astro.props;

const hostnameFrom = (url: string): string => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
const displayUrl = hostnameFrom(hrefUrl);
---

<div class="workCard group relative flex flex-col w-96 max-w-full overflow-hidden bg-base-200 border border-[var(--brand-line)] transition-colors hover:border-[var(--brand-pink-soft)]">
  <div class="flex items-center gap-2 bg-[var(--brand-chrome)] border-b border-[var(--brand-line)] px-4 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-red)]" aria-hidden="true"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-pink)]" aria-hidden="true"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-line)]" aria-hidden="true"></span>
    <span
      class="ml-1 text-xs opacity-60 rounded-full border border-[var(--brand-line)] bg-base-100 px-3 py-0.5"
    >
      {displayUrl}
    </span>
  </div>
  <Image src={image} alt={altText} class="object-cover border-b border-[var(--brand-line)]" />
  <div class="flex flex-col flex-1 p-5 pl-6 text-left">
    <h3 class="text-base font-bold transition-colors group-hover:text-[var(--brand-pink-soft)]">
      {title}
    </h3>
    <p class="text-sm mt-2 mb-4">{message}</p>
    <div class="mt-auto">
      <a
        href={hrefUrl}
        target="_blank"
        class="btn btn-sm rounded border-0 text-white bg-gradient-to-r from-[var(--brand-red)] to-[var(--brand-pink)] hover:brightness-110"
      >
        Visit Site
      </a>
    </div>
  </div>
</div>
