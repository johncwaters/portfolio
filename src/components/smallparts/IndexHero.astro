---
import Header from "../Header.astro";
---

<div class="max-h-screen overflow-hidden">
  <div id="background" class="relative isolate w-full min-h-screen">
    <div class="waveLayer wave-back opacity-0" style="--delay: 1.25s;" aria-hidden="true"></div>
    <div class="waveLayer wave-mid opacity-0" style="--delay: 0.95s;" aria-hidden="true"></div>
    <div class="waveLayer wave-front opacity-0" style="--delay: 0.75s;" aria-hidden="true"></div>
    <Header animDelay={"1.5s"} />

    <div class="hero-overlay opacity-0"></div>
    <div class="hero-content max-w-6xl mx-auto px-6 sm:px-12 sm:pt-32 pt-24">
      <div class="text-left">
        <h1
          class="mb-5 sm:text-2xl text-2xl lineUp opacity-0 min-h-sc"
          style="--delay: 0.1;"
        >
          Hello there! My name is
        </h1>
        <h1
          class="mb-5 sm:text-7xl text-5xl font-bold lineUp opacity-0"
          style="--delay: 0.3s;"
        >
          John C Waters.
        </h1>
        <h1
          class="sm:text-7xl text-5xl font-bold leading-tight lineUp opacity-0"
          style="--delay: 0.9s;"
        >
          I build developer platforms and AI tooling.
        </h1>
      </div>
    </div>
    <div
      class="scroll-button lineUp font-bold text-lg opacity-0"
      style="--delay: 1.1s;"
      tabindex="0"
    >
      <div class="arrow animate-bounce">↓</div> scroll
    </div>
  </div>
</div>

<style>
  /* lineup class and keyframes */
  .lineUp {
    animation: 1.8s anim-lineUp ease-out forwards;
    animation-delay: var(--delay);
  }
  @keyframes anim-lineUp {
    0% {
      opacity: 0;
      transform: translateY(80%);
    }
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
      transform: translateY(0%);
    }
    100% {
      opacity: 1;
      transform: translateY(0%);
    }
  }

  .scroll-button {
    position: absolute;
    bottom: 0;
    left: 3%;
    padding: 2rem 0;
    border: none;
    outline: none;
    cursor: default;
    display: flex;
    transition: opacity 250ms;
  }

  .scroll-button .arrow {
    margin-right: 0.25rem;
  }

  .waveLayer {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    will-change: transform, opacity;
    animation: 1.8s anim-waveRise ease-out forwards;
    animation-delay: var(--delay);
  }
  .wave-back {
    background-image: url("/waves/wave-back.svg");
  }
  .wave-mid {
    background-image: url("/waves/wave-mid.svg");
  }
  .wave-front {
    background-image: url("/waves/wave-front.svg");
  }
  @keyframes anim-waveRise {
    0% {
      opacity: 0;
      transform: translateY(35%);
    }
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
      transform: translateY(0%);
    }
    100% {
      opacity: 1;
      transform: translateY(0%);
    }
  }
</style>
