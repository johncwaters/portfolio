---
import Header from "../Header.astro";
---

<div class="max-h-screen overflow-hidden">
  <div id="background" class="relative isolate w-full min-h-screen">
    <div class="waveLayer wave-back opacity-0" style="--delay: 1.25s;" aria-hidden="true"></div>
    <div class="waveLayer wave-mid opacity-0" style="--delay: 0.95s;" aria-hidden="true"></div>
    <div class="hedgehogPeek">
      <a
        href="/blog/what-context-actually-buys-a-coding-agent/"
        aria-label="Read the PostHog eval writeup"
      >
        <img id="hedgehogPeekImage" alt="" width="360" height="397" />
      </a>
    </div>
    <div class="waveLayer wave-front opacity-0" style="--delay: 0.75s;" aria-hidden="true"></div>
    <Header animDelay={"1.5s"} />

    <div class="hero-overlay opacity-0"></div>
    <div class="hero-content max-w-6xl mx-auto px-6 sm:px-12 sm:pt-32 pt-24">
      <div class="text-left">
        <h1
          class="mb-5 sm:text-2xl text-2xl lineUp opacity-0 min-h-sc"
          style="--delay: 0.1;"
        >
          Hello there! My name is
        </h1>
        <h1
          class="mb-5 sm:text-7xl text-5xl font-bold lineUp opacity-0"
          style="--delay: 0.3s;"
        >
          John C Waters.
        </h1>
        <h1
          class="sm:text-7xl text-5xl font-bold leading-tight lineUp opacity-0"
          style="--delay: 0.9s;"
        >
          I build solutions.
        </h1>
      </div>
    </div>
    <div
      class="scroll-button lineUp font-bold text-lg opacity-0"
      style="--delay: 1.1s;"
      tabindex="0"
    >
      <div class="arrow animate-bounce">↓</div> scroll
    </div>
  </div>
</div>

<style>
  /* lineup class and keyframes */
  .lineUp {
    animation: 1.8s anim-lineUp ease-out forwards;
    animation-delay: var(--delay);
  }
  @keyframes anim-lineUp {
    0% {
      opacity: 0;
      transform: translateY(80%);
    }
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
      transform: translateY(0%);
    }
    100% {
      opacity: 1;
      transform: translateY(0%);
    }
  }

  .scroll-button {
    position: absolute;
    bottom: 0;
    left: 3%;
    padding: 2rem 0;
    border: none;
    outline: none;
    cursor: default;
    display: flex;
    transition: opacity 250ms;
  }

  .scroll-button .arrow {
    margin-right: 0.25rem;
  }

  .waveLayer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-size: cover;
    background-position: center;
    will-change: transform, opacity;
    animation: 1.8s anim-waveRise ease-out forwards;
    animation-delay: var(--delay);
  }
  .wave-back {
    background-image: url("/waves/wave-back.svg");
  }
  .wave-mid {
    background-image: url("/waves/wave-mid.svg");
  }
  .wave-front {
    background-image: url("/waves/wave-front.svg");
  }
  @keyframes anim-waveRise {
    0% {
      opacity: 0;
      transform: translateY(35%);
    }
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
      transform: translateY(0%);
    }
    100% {
      opacity: 1;
      transform: translateY(0%);
    }
  }

  /* PostHog easter egg: sits between the mid and front wave layers (same
     z-index, DOM order decides paint order) so the front wave hides it until
     it rises */
  .hedgehogPeek {
    position: absolute;
    z-index: -1;
    bottom: 13%;
    left: 62%;
    width: clamp(110px, 12vw, 160px);
    /* 45vh keeps the hidden state below the viewport edge, so nothing shows
       while the wave layers are still fading in */
    transform: translateY(45vh) rotate(6deg);
    /* delay holds the peek until the front wave layer (0.75s delay, settled
       by its 50% keyframe at ~1.65s) is in place to rise out of */
    transition: transform 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 1800ms;
    pointer-events: none;
  }
  .hedgehogPeek a {
    display: block;
    pointer-events: auto;
    cursor: pointer;
  }
  /* narrow viewports cover-scale the waves taller, so the crest sits higher */
  @media (max-width: 640px) {
    .hedgehogPeek {
      bottom: 14%;
    }
  }
  #background.showHedgehog .hedgehogPeek {
    transform: translateY(0) rotate(0deg);
  }
  .hedgehogPeek img {
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .hedgehogPeek {
      transition: none;
    }
  }
</style>

<script>
  const revealHedgehog = async () => {
    const hedgehogImage = document.getElementById("hedgehogPeekImage");
    if (!(hedgehogImage instanceof HTMLImageElement)) return;
    hedgehogImage.src = "/hedgehog/waving-hog.png";
    try {
      await hedgehogImage.decode();
    } catch {
      /* a failed decode still leaves whatever the browser managed to load */
    }
    document.getElementById("background")?.classList.add("showHedgehog");
  };

  revealHedgehog();
</script>
