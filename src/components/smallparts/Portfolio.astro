---
import watersMassageLogo from "../../assets/portfolio_logos/wmt_logo.png";
import BlackWiddowTattooLogo from "../../assets/portfolio_logos/black_willow_tattoo_logo.png";
import DevsDailyDigest from "../../assets/portfolio_logos/devs_daily_digest.png";
import CardHarborLogo from "../../assets/portfolio_logos/card_harbor_logo.png";
import GlissaScreenshot from "../../assets/portfolio_logos/glissa_screenshot.png";
import KeeplingsSplashLogo from "../../assets/portfolio_logos/keeplings_splash_logo.png";
import PortfolioCard from "../PortfolioCard.astro";
---

<div id="staryportfolio" class="my-96 p-8">
  <div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">My Works</h1>
    <p class="text-base md:text-lg mb-6">
      Here are some of the public solutions I have made.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto mt-12">
    <PortfolioCard
      image={CardHarborLogo}
      imageFit="contain"
      hrefUrl={"https://cardharbor.watersedgegames.com"}
      title="Card Harbor"
      message={"A Windows desktop app for organizing scanned TCG singles: camera-based card identification, pull sheets, and TCGplayer exports. Built with Electron and React."}
      altText="Card Harbor logo, a rounded navy tile holding a trading card with an ocean wave and dock piling"
    />
    <PortfolioCard
      image={GlissaScreenshot}
      hrefUrl={"https://github.com/johncwaters/glissa"}
      title="Glissa"
      message={"A Windows dashboard for running many Claude Code sessions in parallel, each in its own isolated git worktree. Published on npm."}
      altText="Glissa dashboard showing a Claude Code session in a terminal pane with a session list and review sidebar"
    />
    <PortfolioCard
      image={KeeplingsSplashLogo}
      imageFit="contain"
      hrefUrl={"https://keeplings.watersedgegames.com"}
      title="Keeplings"
      message={"A gentle habit app for Android and iOS where lapses let your companion rest, no streaks, no punishment. Built with Flutter."}
      altText="Keeplings mascot, a smiling yellow cartoon elephant with a small green sprout on its head"
    />
    <PortfolioCard
      image={watersMassageLogo}
      hrefUrl={"https://watersmassage.com/"}
      title={"Waters Massage Therapy"}
      message={"Local traveling massage therapy business with online booking. Built with Astro and React."}
      altText="Waters Massage Therapy Logo, a purple humming bird with the words Waters Massage Therapy to the right."
    />
    <PortfolioCard
      image={BlackWiddowTattooLogo}
      hrefUrl={"https://www.blackwillowtattoo.ink/"}
      title="Black Willow Tattoo"
      message={"A local tattoo artist's business/portfolio website. Built with Astro."}
      altText="Black Willow Tattoo Logo, a spider web with the words Black Willow Tattoo in the middle."
    />
    <PortfolioCard
      image={DevsDailyDigest}
      hrefUrl={"https://devs-daily-digest.vercel.app/"}
      title="Dev's Daily Digest"
      message={"A digital newspaper to keep up on the latest news, without scrolling through emails."}
      altText="An image of the front page of Dev's Daily Digest, with the title and a few articles."
    />
  </div>
</div>
