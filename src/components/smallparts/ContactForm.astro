<div id="contactme" class="my-32">
  <div class="max-w-2xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">Let's talk</h1>
    <p class="text-base md:text-lg mb-6">
      Want to talk shop, ask about something I wrote, or discuss a project?
      Send a message and I will get back to you within a day or so.
    </p>
    <form method="post">
      <fieldset class="fieldset w-full max-w-full mb-6">
        <label class="label" for="fullName">Full name</label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          class="input w-full"
        />
      </fieldset>
      <fieldset class="fieldset w-full max-w-full mb-6">
        <label class="label" for="email">Email address</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="input w-full"
        />
      </fieldset>

      <fieldset class="fieldset w-full max-w-full mb-6">
        <label class="label" for="projectDescription">Message</label>
        <textarea
          id="projectDescription"
          name="projectDescription"
          required
          class="textarea w-full h-24"
          placeholder="What would you like to talk about?"
        ></textarea>
      </fieldset>

      <button
        type="submit"
        id="submitButton"
        class="btn btn-outline btn-block mt-4">Submit</button
      >
    </form>
    <!-- ... Form Feedback Response ... -->
    <div id="message" class="mt-4"></div>
  </div>
</div>

<script>
  // Form Submission Handling
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector("form");
    const messageBox = document.getElementById("message");
    const submitButton = document.getElementById(
      "submitButton"
    ) as HTMLButtonElement;

    if (form && messageBox && submitButton) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        submitButton.disabled = true;
        messageBox.classList.remove("text-green-500", "text-red-500");
        messageBox.innerHTML = `<span class="loading loading-dots loading-lg"></span>`;

        const formData = new FormData(form);

        try {
          const response = await fetch("/api/nodemailer", {
            method: "POST",
            body: formData,
          });

          if (response.ok) {
            messageBox.textContent = "Sent! I will reach out soon.";
            messageBox.classList.add("text-green-500");
            return;
          }

          const errorBody = await response.json().catch(() => null);
          const serverMessage =
            errorBody && typeof errorBody.message === "string"
              ? ` (${errorBody.message})`
              : "";
          messageBox.textContent = `Failed to send message${serverMessage}. Please email me at john@johncwaters.com.`;
          messageBox.classList.add("text-red-500");
        } catch (error) {
          messageBox.textContent =
            "An error occurred while sending the message. Please email me at john@johncwaters.com.";
          messageBox.classList.add("text-red-500");
        } finally {
          submitButton.disabled = false;
        }
      });
    }
  });
</script>
