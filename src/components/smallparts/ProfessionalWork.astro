---
import { projects } from "../../data/projects";
---

<div id="professionalwork" class="my-32 p-8">
  <div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">Professional Work</h1>
    <p class="text-base md:text-lg mb-6">
      Platform engineering, reliability, and AI tooling I have built at work.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      projects.map((project) => (
        <div class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title">{project.title}</h2>
            <p>{project.description}</p>
            <p class="text-sm opacity-70">{project.impact}</p>
            <div class="flex flex-wrap gap-2 mt-2">
              {project.stack.map((tech) => (
                <span class="badge badge-outline">{tech}</span>
              ))}
            </div>
            {project.href && (
              <div class="card-actions mt-4">
                <a href={project.href} class="btn btn-outline btn-sm">
                  Read More
                </a>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>
