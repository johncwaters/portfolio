---
import { projects } from "../../data/projects";
---

<div id="professionalwork" class="my-32 p-8">
  <div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">Professional Work</h1>
    <p class="text-base md:text-lg mb-6">
      Platform engineering, reliability, and AI tooling I have built at work.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      projects.map((project) => (
        <div class="workCard group relative flex flex-col h-full overflow-hidden bg-base-200 border border-[#12455e] transition-colors hover:border-[#ff5c8a]">
          <div class="flex items-center gap-2 bg-[#032033] border-b border-[#12455e] px-4 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff0005]" aria-hidden="true" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff0092]" aria-hidden="true" />
            <span class="h-2.5 w-2.5 rounded-full bg-[#12455e]" aria-hidden="true" />
            <span class="ml-1 text-xs opacity-60">{project.file}</span>
          </div>
          <div class="flex flex-col flex-1 p-6 pl-7 text-left">
            <h2 class="text-lg font-bold transition-colors group-hover:text-[#ff5c8a]">
              {project.title}
            </h2>
            <p class="text-xs uppercase tracking-widest opacity-60 mt-1 mb-4">
              {project.stack.join(" / ")}
            </p>
            <p class="text-sm mb-3">{project.description}</p>
            <p class="text-sm italic opacity-70 mb-5">
              <span class="text-[#ff5c8a] not-italic">{"// "}</span>
              {project.impact}
            </p>
            {project.href && (
              <div class="mt-auto">
                <a
                  href={project.href}
                  class="btn btn-sm rounded border-0 text-white bg-gradient-to-r from-[#ff0005] to-[#ff0092] hover:brightness-110"
                >
                  Read More
                </a>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .workCard::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, #ff0005, #ff0092);
    z-index: 1;
  }
</style>
