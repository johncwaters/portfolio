---
import { projects } from "../../data/projects";
---

<div id="professionalwork" class="my-32 p-8">
  <div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">Professional Work</h1>
    <p class="text-base md:text-lg mb-6">
      Platform engineering, reliability, and AI tooling I have built at work.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      projects.map((project) => (
        <div class="workCard group relative flex flex-col h-full overflow-hidden bg-base-200 border border-[var(--brand-line)] transition-colors hover:border-[var(--brand-pink-soft)]">
          <div class="flex items-center gap-2 bg-[var(--brand-chrome)] border-b border-[var(--brand-line)] px-4 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-red)]" aria-hidden="true" />
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-pink)]" aria-hidden="true" />
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--brand-line)]" aria-hidden="true" />
            <span class="ml-1 text-xs opacity-60">{project.file}</span>
          </div>
          <div class="flex flex-col flex-1 p-6 pl-7 text-left">
            <h2 class="text-lg font-bold transition-colors group-hover:text-[var(--brand-pink-soft)]">
              {project.title}
            </h2>
            <p class="text-xs uppercase tracking-widest opacity-60 mt-1 mb-4">
              {project.stack.join(" / ")}
            </p>
            <p class="text-sm mb-3">{project.description}</p>
            <p class="text-sm italic opacity-70 mb-5">
              <span class="text-[var(--brand-pink-soft)] not-italic">{"// "}</span>
              {project.impact}
            </p>
            {project.href && (
              <div class="mt-auto">
                <a
                  href={project.href}
                  class="btn btn-sm rounded border-0 text-white bg-gradient-to-r from-[var(--brand-red)] to-[var(--brand-pink)] hover:brightness-110"
                >
                  Read More
                </a>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>
