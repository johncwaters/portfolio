---
import { projects } from "../../data/projects";
---

<div id="professionalwork" class="my-32 p-8">
  <div class="max-w-xl mx-auto p-8 text-center">
    <h1 class="text-4xl font-bold mb-1">Professional Work</h1>
    <p class="text-base md:text-lg mb-6">
      Platform engineering, reliability, and AI tooling I have built at work.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
    {
      projects.map((project) => (
        <div class="workCard group relative flex flex-col h-full overflow-hidden bg-[var(--brand-terminal)] border border-[var(--brand-line)] transition-colors hover:border-[var(--brand-pink-soft)]">
          <div
            class="flex items-center gap-2.5 bg-[var(--brand-chrome)] border-b border-[var(--brand-line)] px-4 py-2"
            aria-hidden="true"
          >
            <span class="text-sm font-bold text-[var(--brand-pink-soft)]">&gt;_</span>
            <span class="text-xs opacity-60">john@work: ~/professional</span>
            <span class="ml-auto flex gap-3 text-xs opacity-60">
              <span>_</span>
              <span>&#9633;</span>
              <span>&#10005;</span>
            </span>
          </div>
          <div class="flex flex-col flex-1 p-6 pl-7 text-left">
            <p class="text-xs opacity-60 mb-3">
              <span class="text-[var(--brand-pink-soft)]">{"$ "}</span>
              cat {project.file}
            </p>
            <h2 class="text-lg font-bold transition-colors group-hover:text-[var(--brand-pink-soft)]">
              {project.title}
            </h2>
            <p class="text-xs uppercase tracking-widest opacity-60 mt-1 mb-4">
              {project.stack.join(" / ")}
            </p>
            <p class="text-sm mb-3">{project.description}</p>
            <p class="text-sm italic opacity-70 mb-5">
              <span class="text-[var(--brand-pink-soft)] not-italic">{"# "}</span>
              {project.impact}
            </p>
            {project.href && (
              <a
                href={project.href}
                class="mt-auto self-start text-sm font-bold text-[var(--brand-pink-soft)] hover:text-[var(--brand-pink)] hover:underline"
              >
                <span class="font-normal text-base-content opacity-60">{"$ "}</span>
                Read More
                {" ->"}
                <span class="tmCursor" aria-hidden="true" />
              </a>
            )}
            {!project.href && (
              <p class="mt-auto text-sm" aria-hidden="true">
                <span class="opacity-60">{"$ "}</span>
                <span class="tmCursor" />
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tmCursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    background: var(--brand-pink-soft);
    margin-left: 3px;
    vertical-align: text-bottom;
  }
  .workCard:hover .tmCursor {
    animation: tm-blink 1.1s steps(1) infinite;
  }
  @keyframes tm-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .workCard:hover .tmCursor {
      animation: none;
    }
  }
</style>
