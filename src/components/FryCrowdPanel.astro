---
import type { FryList } from "../data/fryRanking";

export interface Props {
  list: FryList;
}

const { list } = Astro.props;
const columnHeadingClasses = "pb-2 text-xs font-normal tracking-wide uppercase text-base-content/70";
const crowdArtClasses = "size-9 data-logo:rounded-full data-logo:bg-white data-logo:object-contain data-logo:p-1.5 sm:size-10";
---

<section data-fry-crowd={list.id} class="mt-10">
  <h3 class="text-xl font-bold">{list.heading}</h3>
  <p data-crowd-status role="status" class="mt-1 text-sm text-base-content/75"></p>
  <button type="button" data-crowd-reload hidden class="btn btn-sm mt-2">Load the leaderboard</button>
  <table data-crowd-table hidden class="mt-4 w-full border-collapse">
    <caption class="sr-only">{list.heading}, ordered by the average spot readers gave each one</caption>
    <thead>
      <tr>
        <th scope="col" class:list={[columnHeadingClasses, "w-7 text-right sm:w-8"]}>#</th>
        <th scope="col" colspan="2"><span class="sr-only">Name</span></th>
        <th scope="col" class:list={[columnHeadingClasses, "w-12 pl-2 text-right sm:w-auto sm:pl-3 sm:whitespace-nowrap"]}>Avg spot</th>
        <th scope="col" class:list={[columnHeadingClasses, "w-12 pl-2 text-right sm:w-auto sm:pl-3 sm:whitespace-nowrap"]}>Vs. mine</th>
      </tr>
    </thead>
    <tbody data-crowd-order></tbody>
  </table>
  <p data-crowd-fight hidden class="mt-4 max-w-[65ch] border-t border-(--brand-line) pt-4"></p>
  <div data-crowd-added hidden class="mt-8">
    <table class="w-full border-collapse">
      <caption class="pb-2 text-left text-sm font-bold tracking-wide uppercase opacity-80">Added by readers</caption>
      <thead>
        <tr>
          <th scope="col" colspan="2"><span class="sr-only">Name</span></th>
          <th scope="col" class:list={[columnHeadingClasses, "pl-2 text-right whitespace-nowrap sm:pl-3"]}>Added by</th>
          <th scope="col" class:list={[columnHeadingClasses, "w-16 pl-4 text-right sm:w-auto sm:whitespace-nowrap"]}>Avg spot</th>
        </tr>
      </thead>
      <tbody data-crowd-added-rows></tbody>
    </table>
  </div>
  <template data-crowd-row>
    <tr class="group border-t border-(--brand-line)">
      <td data-crowd-rank class="py-2 text-right text-xl font-bold tabular-nums group-first:text-[#ff5c8a]"></td>
      <td class="w-11 py-2 pl-2 sm:w-13 sm:pl-3"><img data-crowd-art alt="" width="200" height="200" class={crowdArtClasses} /></td>
      <th scope="row" class="py-2 pl-2 text-left sm:pl-3">
        <span data-crowd-name class="block leading-tight font-bold sm:text-lg"></span>
        <span class="mt-1.5 block h-1 overflow-hidden rounded-full bg-(--brand-line)">
          <span data-crowd-bar class="block h-full origin-left rounded-full bg-base-content/45 group-first:bg-[#ff5c8a]"></span>
        </span>
      </th>
      <td data-crowd-average class="py-2 pl-2 text-right tabular-nums sm:pl-3 sm:text-lg"></td>
      <td class="py-2 pl-2 text-right whitespace-nowrap tabular-nums sm:pl-3">
        <span data-crowd-versus aria-hidden="true" class="text-base-content/60 data-[versus=higher]:font-bold data-[versus=higher]:text-[#ff5c8a] data-[versus=lower]:text-base-content"></span>
        <span data-crowd-versus-spoken class="sr-only"></span>
      </td>
    </tr>
  </template>
  <template data-crowd-added-row>
    <tr class="border-t border-(--brand-line)">
      <td class="w-9 py-2 sm:w-10"><img data-crowd-art alt="" width="200" height="200" class={crowdArtClasses} /></td>
      <th scope="row" data-crowd-name class="py-2 pl-3 text-left leading-tight font-bold sm:text-lg"></th>
      <td data-crowd-added-share class="py-2 pl-3 text-right whitespace-nowrap tabular-nums"></td>
      <td data-crowd-average class="py-2 pl-4 text-right tabular-nums sm:text-lg"></td>
    </tr>
  </template>
</section>
